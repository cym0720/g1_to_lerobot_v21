{
    "description":  "618data 转为 LeRobot 时使用的可编辑 schema。由转换器读取，不属于预览工具。",
    "fps":  30,
    "exclude_modalities":  [
                               "depth"
                           ],
    "cameras":  {
                    "observation.images.cam_high_rgb":  {
                                                            "source":  "camera/head_color/head_color.h265",
                                                            "timestamp_source":  "camera/head_color/head_color.txt",
                                                            "kind":  "h265_timestamp_aligned",
                                                            "source_shape":  [
                                                                                 800,
                                                                                 1280,
                                                                                 3
                                                                             ],
                                                            "output_shape":  [
                                                                                 720,
                                                                                 1280,
                                                                                 3
                                                                             ],
                                                            "transform":  "center_crop_vertical",
                                                            "crop":  {
                                                                         "x":  0,
                                                                         "y":  40,
                                                                         "width":  1280,
                                                                         "height":  720
                                                                     },
                                                            "reference":  "对齐 robocoin 头部 RGB 尺度；转换器必须同步更新主点 ppy = 原始 ppy - 40"
                                                        },
                    "observation.images.cam_left_wrist_rgb":  {
                                                                  "source":  "camera/hand_left/color/*.jpg",
                                                                  "kind":  "jpg_timestamp_aligned",
                                                                  "output_shape":  [
                                                                                       480,
                                                                                       848,
                                                                                       3
                                                                                   ],
                                                                  "transform":  "identity",
                                                                  "reference":  "robocoin"
                                                              },
                    "observation.images.cam_right_wrist_rgb":  {
                                                                   "source":  "camera/hand_right/color/*.jpg",
                                                                   "kind":  "jpg_timestamp_aligned",
                                                                   "output_shape":  [
                                                                                        480,
                                                                                        848,
                                                                                        3
                                                                                    ],
                                                                   "transform":  "identity",
                                                                   "reference":  "robocoin"
                                                               },
                    "observation.images.cam_high_center_fisheye_rgb":  {
                                                                           "source":  "camera/head_center_fisheye/head_center_fisheye.h265",
                                                                           "timestamp_source":  "camera/head_center_fisheye/head_center_fisheye.txt",
                                                                           "kind":  "h265_timestamp_aligned",
                                                                           "output_shape":  [
                                                                                                1536,
                                                                                                1920,
                                                                                                3
                                                                                            ],
                                                                           "transform":  "identity",
                                                                           "reference":  "robocoin observation.images.cam_high_center_fisheye_rgb"
                                                                       },
                    "observation.images.cam_high_left_fisheye_rgb":  {
                                                                         "source":  "camera/head_left_fisheye/head_left_fisheye.h265",
                                                                         "timestamp_source":  "camera/head_left_fisheye/head_left_fisheye.txt",
                                                                         "kind":  "h265_timestamp_aligned",
                                                                         "output_shape":  [
                                                                                              1536,
                                                                                              1920,
                                                                                              3
                                                                                          ],
                                                                         "transform":  "identity",
                                                                         "reference":  "robocoin observation.images.cam_high_left_fisheye_rgb"
                                                                     },
                    "observation.images.cam_high_right_fisheye_rgb":  {
                                                                          "source":  "camera/head_right_fisheye/head_right_fisheye.h265",
                                                                          "timestamp_source":  "camera/head_right_fisheye/head_right_fisheye.txt",
                                                                          "kind":  "h265_timestamp_aligned",
                                                                          "output_shape":  [
                                                                                               1536,
                                                                                               1920,
                                                                                               3
                                                                                           ],
                                                                          "transform":  "identity",
                                                                          "reference":  "robocoin observation.images.cam_high_right_fisheye_rgb"
                                                                      }
                },
    "task_map":  "task_id_map.json",
    "field_definitions":  "618_field_definitions.json"
}
